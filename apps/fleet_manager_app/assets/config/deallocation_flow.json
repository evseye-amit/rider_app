{
  "id": "vehicle_deallocation",
  "title": "@allocationDeAllocateVehicle",
  "meta": {
    "note": "Two OTPs close this flow — one from the rider and one from the team lead — so a vehicle can never be taken back on one person's word alone."
  },
  "steps": [
    {
      "key": "photos",
      "label": "@deallocReturnPhotos",
      "shortLabel": "Photos",
      "icon": "camera",
      "screen": {
        "id": "deallocation_photos",
        "title": "@deallocReturnCondition",
        "subtitle": "@deallocPhotographVehicleExactlyAsCame",
        "body": [
          {
            "type": "banner",
            "props": {
              "tone": "warning",
              "icon": "warning",
              "title": "@deallocCompareAgainstHandoverSet",
              "message": "@deallocAnyNewDamageRecordHere"
            }
          },
          {
            "type": "group",
            "props": {
              "title": "@deallocVehicleAngles",
              "icon": "camera",
              "gap": 16
            },
            "children": [
              {
                "type": "photoGrid",
                "id": "returnPhotos",
                "props": {
                  "key": "returnPhotos",
                  "columns": 2,
                  "slots": [
                    {
                      "value": "left",
                      "label": "@allocationLeftSide",
                      "icon": "camera"
                    },
                    {
                      "value": "right",
                      "label": "@allocationRightSide",
                      "icon": "camera"
                    },
                    {
                      "value": "front",
                      "label": "@allocationFront",
                      "icon": "camera"
                    },
                    {
                      "value": "back",
                      "label": "@allocationBack",
                      "icon": "camera"
                    }
                  ]
                }
              }
            ]
          },
          {
            "type": "group",
            "props": {
              "title": "@deallocComponents",
              "icon": "iot",
              "gap": 16
            },
            "children": [
              {
                "type": "photoGrid",
                "id": "componentPhotos",
                "props": {
                  "key": "componentPhotos",
                  "columns": 2,
                  "slots": [
                    {
                      "value": "iot",
                      "label": "@commonIotUnit",
                      "icon": "iot"
                    },
                    {
                      "value": "battery",
                      "label": "@maintenanceBattery",
                      "icon": "battery"
                    }
                  ]
                }
              }
            ]
          },
          {
            "type": "textField",
            "id": "returnOdometer",
            "props": {
              "key": "returnOdometer",
              "label": "@deallocOdometerReturn",
              "hint": "14880",
              "keyboard": "number",
              "icon": "speed"
            },
            "visibleWhen": {
              "flag": "ODOMETER_CAPTURE"
            },
            "validations": [
              {
                "type": "required",
                "message": "@deallocEnterClosingOdometer"
              }
            ]
          }
        ],
        "footer": [
          {
            "type": "primaryButton",
            "props": {
              "label": "@deallocContinueAssessment",
              "icon": "assignment"
            },
            "action": {
              "type": "next"
            }
          }
        ]
      }
    },
    {
      "key": "assessment",
      "label": "@deallocAssessment",
      "shortLabel": "Damage",
      "icon": "build",
      "screen": {
        "id": "deallocation_assessment",
        "title": "@deallocConditionAssessment",
        "subtitle": "@deallocRecordWhatComesBackWhat",
        "body": [
          {
            "type": "group",
            "props": {
              "title": "@deallocVehicleCondition",
              "icon": "build",
              "gap": 16
            },
            "visibleWhen": {
              "flag": "DAMAGE_ASSESSMENT"
            },
            "children": [
              {
                "type": "radioGroup",
                "id": "condition",
                "props": {
                  "key": "condition",
                  "options": [
                    {
                      "value": "excellent",
                      "label": "@deallocExcellent",
                      "subtitle": "@deallocNoDamageBeyondNormalWear"
                    },
                    {
                      "value": "good",
                      "label": "@deallocGood",
                      "subtitle": "@deallocMinorScuffsNothingRecover"
                    },
                    {
                      "value": "damaged",
                      "label": "@deallocDamaged",
                      "subtitle": "@deallocRecoverableDamageRaiseMaintenanceJob"
                    }
                  ]
                },
                "validations": [
                  {
                    "type": "required",
                    "message": "@deallocRecordVehicleCondition"
                  }
                ]
              },
              {
                "type": "textField",
                "id": "damageNotes",
                "props": {
                  "key": "damageNotes",
                  "label": "@deallocDamageDescription",
                  "hint": "@deallocWhatDamagedHowBadly",
                  "maxLines": 4,
                  "keyboard": "multiline"
                },
                "visibleWhen": {
                  "field": "condition",
                  "equals": "damaged"
                },
                "validations": [
                  {
                    "type": "required",
                    "message": "@deallocDescribeDamage"
                  }
                ]
              },
              {
                "type": "textField",
                "id": "recoveryAmount",
                "props": {
                  "key": "recoveryAmount",
                  "label": "@deallocEstimatedRecovery",
                  "hint": "2500",
                  "keyboard": "number",
                  "icon": "rupee",
                  "helper": "@deallocDeductedFromRidersSecurityDeposit"
                },
                "visibleWhen": {
                  "field": "condition",
                  "equals": "damaged"
                },
                "validations": [
                  {
                    "type": "required"
                  }
                ]
              }
            ]
          },
          {
            "type": "group",
            "props": {
              "title": "@deallocAccessoriesReturned",
              "icon": "assignment",
              "gap": 12
            },
            "children": [
              {
                "type": "checkbox",
                "id": "retHelmet",
                "props": {
                  "key": "retHelmet",
                  "label": "@scooterHelmet"
                }
              },
              {
                "type": "checkbox",
                "id": "retBox",
                "props": {
                  "key": "retBox",
                  "label": "@scooterDeliveryBox"
                }
              },
              {
                "type": "checkbox",
                "id": "retCharger",
                "props": {
                  "key": "retCharger",
                  "label": "@deallocChargerCable"
                }
              },
              {
                "type": "checkbox",
                "id": "retDocs",
                "props": {
                  "key": "retDocs",
                  "label": "@deallocRcInsurancePuc"
                }
              }
            ]
          },
          {
            "type": "group",
            "props": {
              "title": "@maintenanceBattery",
              "icon": "battery",
              "gap": 16
            },
            "visibleWhen": {
              "flag": "BATTERY_MAPPING"
            },
            "children": [
              {
                "type": "textField",
                "id": "batteryReturnPercent",
                "props": {
                  "key": "batteryReturnPercent",
                  "label": "@deallocChargeReturn",
                  "hint": "12",
                  "keyboard": "number",
                  "maxLength": 3,
                  "icon": "battery"
                },
                "validations": [
                  {
                    "type": "required"
                  },
                  {
                    "type": "max",
                    "value": 100
                  }
                ]
              },
              {
                "type": "switchTile",
                "id": "batteryReturned",
                "props": {
                  "key": "batteryReturned",
                  "label": "@deallocBatteryReturnedHub",
                  "subtitle": "@deallocLoggedBackIntoChargingBay"
                },
                "validations": [
                  {
                    "type": "required",
                    "message": "@deallocConfirmBatteryBack"
                  }
                ]
              }
            ]
          }
        ],
        "footer": [
          {
            "type": "primaryButton",
            "props": {
              "label": "@deallocContinueVerification",
              "icon": "lock"
            },
            "action": {
              "type": "next"
            }
          }
        ]
      }
    },
    {
      "key": "verification",
      "label": "@deallocVerification",
      "shortLabel": "OTP",
      "icon": "lock",
      "screen": {
        "id": "deallocation_verification",
        "title": "@deallocTwoPartyVerification",
        "subtitle": "@deallocBothRiderTeamLeadMust",
        "body": [
          {
            "type": "banner",
            "props": {
              "tone": "brand",
              "icon": "shield",
              "message": "@deallocCodesValid10MinutesAsk"
            }
          },
          {
            "type": "group",
            "props": {
              "title": "@deallocRiderConfirmation",
              "icon": "person",
              "gap": 16
            },
            "visibleWhen": {
              "flag": "RIDER_OTP"
            },
            "children": [
              {
                "type": "text",
                "props": {
                  "text": "Code sent to the rider's registered mobile",
                  "style": "bodySmall"
                }
              },
              {
                "type": "otpField",
                "id": "riderOtp",
                "props": {
                  "key": "riderOtp",
                  "length": 6
                },
                "validations": [
                  {
                    "type": "required",
                    "message": "@deallocEnterRidersCode"
                  },
                  {
                    "type": "minLength",
                    "value": 6,
                    "message": "@deallocEnterAll6Digits"
                  }
                ]
              }
            ]
          },
          {
            "type": "group",
            "props": {
              "title": "@deallocTeamLeadConfirmation",
              "icon": "badge",
              "gap": 16
            },
            "visibleWhen": {
              "flag": "TEAM_LEAD_OTP"
            },
            "children": [
              {
                "type": "text",
                "props": {
                  "text": "Code sent to the team lead on record for this rider",
                  "style": "bodySmall"
                }
              },
              {
                "type": "otpField",
                "id": "teamLeadOtp",
                "props": {
                  "key": "teamLeadOtp",
                  "length": 6
                },
                "validations": [
                  {
                    "type": "required",
                    "message": "@deallocEnterTeamLeadsCode"
                  },
                  {
                    "type": "minLength",
                    "value": 6,
                    "message": "@deallocEnterAll6Digits"
                  }
                ]
              }
            ]
          },
          {
            "type": "group",
            "props": {
              "title": "@deallocCloseRide",
              "icon": "route",
              "gap": 12
            },
            "children": [
              {
                "type": "checkbox",
                "id": "rideEnded",
                "props": {
                  "key": "rideEnded",
                  "label": "@deallocEndRidersActiveRide",
                  "subtitle": "@deallocStopsTelemetryClosesShiftSettles"
                },
                "validations": [
                  {
                    "type": "required",
                    "message": "@deallocEndRideContinue"
                  }
                ]
              },
              {
                "type": "pickerField",
                "id": "fleetStatus",
                "props": {
                  "key": "fleetStatus",
                  "label": "@deallocSetFleetStatus",
                  "icon": "scooter",
                  "options": [
                    {
                      "value": "available",
                      "label": "@deallocAvailable",
                      "subtitle": "@deallocReadyAllocateAnotherRider"
                    },
                    {
                      "value": "service",
                      "label": "@deallocService",
                      "subtitle": "@deallocSendWorkshopFirst"
                    },
                    {
                      "value": "offroad",
                      "label": "@deallocOffRoad",
                      "subtitle": "@deallocNotUsableUntilFurtherNotice"
                    }
                  ]
                },
                "visibleWhen": {
                  "flag": "FLEET_STATUS_UPDATE"
                },
                "validations": [
                  {
                    "type": "required",
                    "message": "@deallocSetFleetStatus2"
                  }
                ]
              }
            ]
          }
        ],
        "footer": [
          {
            "type": "primaryButton",
            "props": {
              "label": "@deallocCompleteDeAllocation",
              "icon": "check"
            },
            "action": {
              "type": "next"
            }
          }
        ]
      }
    }
  ]
}
